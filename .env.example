# ── LLM provider ──────────────────────────────────────────────────────────────
# Which LLM backend to use.  Accepted values: langchain (default), huggingface
LLM_PROVIDER=langchain

# ── OpenAI (used when LLM_PROVIDER=langchain) ─────────────────────────────────
OPENAI_API_KEY=your_open_ai_secret_key_here
# Optional: override the default model (gpt-3.5-turbo)
# OPENAI_MODEL=gpt-3.5-turbo

# ── HuggingFace (used when LLM_PROVIDER=huggingface) ──────────────────────────
# Your HuggingFace Hub API token
HUGGINGFACEHUB_API_TOKEN=your_huggingface_hub_api_token_here
# Optional: override the default repo (google/flan-t5-xxl)
# HUGGINGFACEHUB_REPO_ID=google/flan-t5-xxl

# ── Telegram bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
